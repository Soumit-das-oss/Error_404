# Database Engine (Defaults to embedded SQLite for zero-config local run)
DATABASE_URL=sqlite:///./vajra.db
# Enterprise PostgreSQL Alternative:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/vajra_db

# Cryptographic Security
SECRET_KEY=change-this-to-a-secure-random-secret-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ENVIRONMENT=development

# Ingestion Payload Ceiling (25MB in bytes: 25 * 1024 * 1024)
MAX_PAYLOAD_BYTES=26214400

# Local Air-Gapped LLM Reasoning (Ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

# Forensic Threat Intelligence Paths
GEOIP_CITY_PATH=data/GeoLite2-City.mmdb
GEOIP_ASN_PATH=data/GeoLite2-ASN.mmdb
TOR_EXIT_NODES_PATH=data/tor_exit_nodes.txt
DNS_TIMEOUT_SECONDS=3.0

# CORS Allowed Origins
CORS_ORIGINS=["*"]
