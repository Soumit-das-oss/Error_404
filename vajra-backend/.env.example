# Environment & Project Configuration
ENVIRONMENT=development
PROJECT_NAME="VAJRA Forensics - AI-Powered Threat Intelligence Platform"

# AI Inference Providers (Tier 1 Cloud Groq -> Tier 2 Local Ollama -> Tier 3 Deterministic Fallback)
GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL=llama-3.1-8b-instant
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3.2:1b
GROQ_TIMEOUT_SECONDS=3.5
OLLAMA_TIMEOUT_SECONDS=5.0

# Ingestion Payload Ceiling (25MB in bytes: 25 * 1024 * 1024)
MAX_PAYLOAD_BYTES=26214400

# Defensive DNS Resolution
DNS_TIMEOUT_SECONDS=3.0

# CORS Allowed Origins
CORS_ORIGINS=["*"]
