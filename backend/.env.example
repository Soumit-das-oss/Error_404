# Environment & Project Configuration
ENVIRONMENT=development
PROJECT_NAME="VAJRA Forensics - AI-Powered Threat Intelligence Platform (SIH26106)"
PROBLEM_STATEMENT=SIH26106

# AI Inference Providers (Tier 1 Cloud Groq -> Tier 2 Local Ollama -> Tier 3 Deterministic Fallback)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
LLM_MODEL=llama-3.3-70b-versatile
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3.2:1b
GROQ_TIMEOUT_SECONDS=4.0
OLLAMA_TIMEOUT_SECONDS=15.0

# Ingestion Payload Ceiling (25MB in bytes: 25 * 1024 * 1024)
MAX_PAYLOAD_BYTES=26214400

# Defensive DNS Resolution
DNS_TIMEOUT_SECONDS=3.0

# CORS Allowed Origins (Strict Whitelist for Local React Development)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]
